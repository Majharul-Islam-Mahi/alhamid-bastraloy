# ============================================================
# আল হামিদ বস্ত্রালয় — Environment Variables
# ============================================================
# এই ফাইল কপি করে .env নামে রাখুন এবং মান পূরণ করুন।
# সতর্কতা: .env ফাইল কখনো git-এ commit করবেন না!
# ============================================================

# ------------------------------------------------------------
# Supabase (বাধ্যতামূলক)
# ------------------------------------------------------------
# Supabase Dashboard → Project Settings → API থেকে পাবেন
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Vite (client-side) — একই মান, VITE_ prefix সহ
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ------------------------------------------------------------
# ডাটাবেজ মাইগ্রেশন (শুধু drizzle-kit এর জন্য)
# ------------------------------------------------------------
# Supabase Dashboard → Settings → Database → Connection String (URI)
LOVABLE_DB_MIGRATION_URL=""

# ------------------------------------------------------------
# OTP — কোন চ্যানেল দিয়ে পাঠাবেন
# ------------------------------------------------------------
# অপশন:
#   "demo"       → শুধু স্ক্রিনে কোড দেখাবে (ডেভেলপমেন্ট)
#   "console"    → সার্ভার কনসোলে কোড দেখাবে
#   "whatsapp"   → WhatsApp Cloud API (Meta) — সেটআপ গাইড দেখুন
#   "sms_ssl"    → SSL Wireless (বাংলাদেশ)
#   "sms_bulkbd" → Bulk SMS BD (বাংলাদেশ)
#
# শুরুতে "demo" রাখুন — সব কাজ করলে পরে পরিবর্তন করে দিন।
OTP_CHANNEL="demo"

# ------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# ------------------------------------------------------------
# শুধু OTP_CHANNEL="whatsapp" হলে দরকার
# Setup guide: docs/otp-setup.md
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
# Template নাম (Meta Business Manager-এ বানাতে হবে)
WHATSAPP_TEMPLATE_NAME="otp_verification"
WHATSAPP_TEMPLATE_LANG="bn"

# ------------------------------------------------------------
# SSL Wireless (বাংলাদেশী SMS)
# ------------------------------------------------------------
# শুধু OTP_CHANNEL="sms_ssl" হলে দরকার
# যোগাযোগ: https://www.sslwireless.com/
SSL_WIRELESS_API_KEY=""
SSL_WIRELESS_SID=""
SSL_WIRELESS_SENDER_ID="ALHAMID"

# ------------------------------------------------------------
# Bulk SMS BD (বাংলাদেশী SMS)
# ------------------------------------------------------------
# শুধু OTP_CHANNEL="sms_bulkbd" হলে দরকার
# যোগাযোগ: https://bulksmsbd.net/
BULKSMSBD_API_KEY=""
BULKSMSBD_SENDER_ID="ALHAMID"

# ------------------------------------------------------------
# Cron (ঐচ্ছিক — যদি scheduled job চালাতে হয়)
# ------------------------------------------------------------
# এই ডকুমেন্টে এখনো ব্যবহার হয়নি, ভবিষ্যতের জন্য রাখা
CRON_SECRET=""